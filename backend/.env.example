# Copy this file to .env and fill in real values locally.
# Do NOT commit .env — it is gitignored.
#
# Supabase: Dashboard → Project Settings → API
# Database: Dashboard → Project Settings → Database → Connection string

# --- Supabase (Auth + API) ---

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# --- Postgres (Alembic + direct DB access) ---

# Use the DIRECT connection (host: db.<ref>.supabase.co) on macOS/Linux.
# On Windows, if migrations fail with "could not translate host name", use the
# Session pooler URI instead (port 5432, NOT transaction mode on 6543):
#   postgresql://postgres.<ref>:PASSWORD@aws-0-<region>.pooler.supabase.com:5432/postgres
# Copy the exact Session pooler string from Supabase → Settings → Database.
DATABASE_URL=postgresql://postgres:YOUR_DB_PASSWORD@db.your-project-ref.supabase.co:5432/postgres

# --- OpenAI (LLM + embeddings) ---

OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536

# --- Server ---

# Railway sets PORT for you. Leave this unset locally unless you want
# `python -m app.main` on a port other than 8000.
# PORT=8000

# Comma-separated browser origins allowed to call the API (CORS).
# After the frontend has a public Railway URL, add it here with no trailing slash:
#   https://your-frontend.up.railway.app
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://[::1]:5173
